# Copier ce fichier en ".env" puis changer les mots de passe avant tout usage hors poste de développement.
PSIM_PORT=3033
PSIM_HOST=127.0.0.1
PSIM_MQTT_PORT=1883
PSIM_MQTT_USER=psim
PSIM_MQTT_PASSWORD=psim-dev-only
PSIM_ADMIN_PASSWORD=admin-dev-only
PSIM_OPERATOR_PASSWORD=operator-dev-only
# Panneau "Simulateur" (déclenche des alarmes via MQTT). Mettre 0 en production.
PSIM_SIM_ENABLED=1
# Comptes cliquables sur la page de connexion (les mots de passe sont alors visibles depuis le navigateur).
# Actif par defaut seulement en poste local SANS fichier .env. Ne jamais mettre 1 sur une installation reelle.
# PSIM_DEMO_LOGIN=0
# Mettre 1 derrière HTTPS pour marquer le cookie de session "Secure".
PSIM_COOKIE_SECURE=0
# Chemin de ffmpeg (necessaire pour les cameras reelles). Par defaut : "ffmpeg" trouve dans le PATH.
# PSIM_FFMPEG=C:\outils\ffmpeg\bin\ffmpeg.exe
# Cle de chiffrement (64 caracteres hexadecimaux) des mots de passe des cameras.
# Si absente, une cle est creee dans data/secret.key au premier demarrage.
# PSIM_SECRET_KEY=
