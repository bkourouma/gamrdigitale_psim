# Copier ce fichier en ".env" puis changer les mots de passe avant tout usage hors poste de développement.
#
# --- PRODUCTION --------------------------------------------------------------------------------------------
# PSIM_ENV=production      le PSIM REFUSE de demarrer si mal configure (voir « Mise en production » du README).
#                          Verifier sans demarrer : npm run check-config
# PSIM_REQUIRE_2FA=admin                none | admin | all : double authentification obligatoire (admin par defaut en production)
# PSIM_TLS_CERT=C:/psim/tls/cert.pem     HTTPS integre (fichiers PEM). Certificat de test : npm run make-cert
# PSIM_TLS_KEY=C:/psim/tls/key.pem
# PSIM_HTTP_REDIRECT_PORT=80             port HTTP qui redirige vers HTTPS (0 = aucun)
# PSIM_TRUST_PROXY=0                     1 derriere un proxy HTTPS (et mettre PSIM_COOKIE_SECURE=1)
# PSIM_MQTT_HOST=127.0.0.1               0.0.0.0 pour des detecteurs distants (preferer le TLS ci-dessous)
# PSIM_MQTT_TLS_CERT=                    MQTT chiffre (mqtts)
# PSIM_MQTT_TLS_KEY=
# PSIM_BACKUP_DIR=E:/sauvegardes-psim    de preference un AUTRE disque que les donnees
# PSIM_BACKUP_EVERY_H=24                 sauvegarde automatique (24 par defaut en production, 0 = coupee)
# PSIM_BACKUP_KEEP=14                    nombre de sauvegardes conservees
# PSIM_LOG_FILE=1                        journal dans data/logs/psim.log (actif par defaut en production)
#
PSIM_PORT=3033
PSIM_HOST=127.0.0.1
PSIM_MQTT_PORT=1883
PSIM_MQTT_USER=psim
PSIM_MQTT_PASSWORD=psim-dev-only
PSIM_ADMIN_PASSWORD=admin-dev-only
PSIM_OPERATOR_PASSWORD=operator-dev-only
# Panneau "Simulateur" (déclenche des alarmes via MQTT). Mettre 0 en production.
PSIM_SIM_ENABLED=1
# Detecteur muet : delai (secondes) sans message avant de le declarer "hors ligne". 0 = desactive.
# Par defaut : 180 en exploitation (PSIM_SIM_ENABLED=0), desactive en mode simulateur.
# Regler selon le signal de vie de vos detecteurs (comptez 3 a 4 fois leur periode d'emission).
# PSIM_DETECTOR_TIMEOUT_S=180
# PSIM_INGEST_TOKEN=                   jeton (24 caracteres minimum) de l'entree HTTP POST /api/ingest/<id> pour controle d'acces / IoT ; vide = entree fermee
# --- Notifications (laisser vide = aucune notification hors de l'ecran) ---------------------------------
# Niveau 1 = prevenu des l'ouverture ; niveau 2 = prevenu si personne n'acquitte (escalade).
# Listes separees par des virgules.
# PSIM_NOTIFY_EMAIL_L1=agent@exemple.fr
# PSIM_NOTIFY_EMAIL_L2=responsable@exemple.fr
# PSIM_SMTP_HOST=smtp.exemple.fr
# PSIM_SMTP_PORT=587
# PSIM_SMTP_SECURE=0            # 1 = TLS direct (port 465) ; 0 = STARTTLS si disponible
# PSIM_SMTP_STARTTLS=1          # 0 = relais interne en clair, sans STARTTLS
# PSIM_SMTP_USER=
# PSIM_SMTP_PASSWORD=
# PSIM_SMTP_FROM=psim@exemple.fr
# PSIM_TELEGRAM_TOKEN=          # jeton du bot (BotFather)
# PSIM_NOTIFY_TELEGRAM_L1=123456789       # identifiants de conversation
# PSIM_NOTIFY_TELEGRAM_L2=-1001234567890
# PSIM_NOTIFY_WEBHOOK_L1=https://hooks.exemple.fr/xxx
# PSIM_NOTIFY_WEBHOOK_L2=
# PSIM_WEBHOOK_SECRET=          # signe les webhooks (HMAC SHA-256, en-tete X-PSIM-Signature)
# PSIM_PUBLIC_URL=https://psim.exemple.fr   # lien ajoute aux messages
# PSIM_ESCALATE_AFTER_S=180     # delai sans acquittement avant d'avertir le niveau 2 (0 = pas d'escalade)
# PSIM_REMINDER_S=300           # delai entre deux rappels
# PSIM_MAX_REMINDERS=3          # nombre maximal de rappels
# Gestion des risques : periode (jours) de l'historique d'incendies, age (mois) d'une evaluation « a revoir ».
# PSIM_RISK_FIRE_WINDOW_DAYS=180
# PSIM_RISK_STALE_MONTHS=12
# Conservation des images prises a chaque etape d'un incident (jours ; 0 = indefiniment).
# PSIM_SNAPSHOT_DAYS=30
# Regles anti-fausses alarmes (secondes ; 0 = regle desactivee). Elles QUALIFIENT les incidents
# ("a confirmer" / "confirme" / "probable fausse alarme") sans jamais retarder, masquer ni fermer une alarme.
# Confirmation par detecteur voisin (meme zone ou camera en commun) declenche dans cette fenetre :
# PSIM_CONFIRM_WINDOW_S=60
# Confirmation par persistance (detecteur toujours en alarme / prealarme apres ce delai) :
# PSIM_CONFIRM_PERSIST_S=120
# Indice "probable fausse alarme" (detecteur isole revenu a la normale en moins de ce delai) :
# PSIM_FALSE_ALARM_HINT_S=30
# Comptes cliquables sur la page de connexion (les mots de passe sont alors visibles depuis le navigateur).
# Actif par defaut seulement en poste local SANS fichier .env. Ne jamais mettre 1 sur une installation reelle.
# PSIM_DEMO_LOGIN=0
# Mettre 1 derrière HTTPS pour marquer le cookie de session "Secure".
PSIM_COOKIE_SECURE=0
# Chemin de ffmpeg (necessaire pour les cameras reelles). Par defaut : "ffmpeg" trouve dans le PATH.
# PSIM_FFMPEG=C:\outils\ffmpeg\bin\ffmpeg.exe
# Cle de chiffrement (64 caracteres hexadecimaux) des mots de passe des cameras.
# Si absente, une cle est creee dans data/secret.key au premier demarrage.
# PSIM_SECRET_KEY=
