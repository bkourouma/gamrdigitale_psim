      "html": "<span class=\"ds-tube\"><span class=\"ds-tube-fill\"></span></span>",
      "css": ".ds-tube{position:relative;display:block;height:14px;min-width:96px;border:1.5px solid #99d6f3;border-radius:999px;background:#e2f3fd;overflow:hidden}.ds-tube-fill{position:absolute;inset:0;background:linear-gradient(to right,#5da444 0 13.33%,#f7d23a 13.33% 33.33%,#f08a2c 33.33% 60%,#e04a32 60% 100%);clip-path:inset(0 45% 0 0 round 0 999px 999px 0)}.ds-tube::after{content:'';position:absolute;inset:0;background:linear-gradient(#99d6f3,#99d6f3) 13.33% 0/1px 100% no-repeat,linear-gradient(#99d6f3,#99d6f3) 33.33% 0/1px 100% no-repeat,linear-gradient(#99d6f3,#99d6f3) 60% 0/1px 100% no-repeat}"
