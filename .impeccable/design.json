      "css": ".ds-arm-track{position:relative;display:block;width:320px;height:16px;overflow:hidden;border:1.5px solid #99d6f3;border-radius:999px;background:#e2f3fd}.ds-arm-seg{position:absolute;top:0;bottom:0;left:0;width:30%;background:#234f93}.ds-arm-now{position:absolute;top:0;bottom:0;left:62%;width:3px;margin-left:-1.5px;background:#fadf38;box-shadow:0 0 0 1px #10264a}"
