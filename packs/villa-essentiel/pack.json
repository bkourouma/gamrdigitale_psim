  "description": "Voir et être prévenu. Villa à étage : 2 caméras extérieures (portail, jardin) sur un enregistreur Dahua 4 voies supervisé sur le réseau, détection de personnes de l'enregistreur au portail armée la nuit, 2 détecteurs de fumée WiFi Tuya / Smart Life (séjour, couloir de l'étage), lus par le PSIM dans le cloud Tuya sans passerelle. Qualifié : le détecteur de fumée WiFi Tuya. Caméras, enregistreur 4 voies XVR5104HS-I3 et sa détection de personnes sont à qualifier (seule une voie d'un XVR5108HS-I3/T a été essayée sur matériel réel ; le registre de qualification n'en déduit rien pour le XVR5104HS-I3). Prérequis : compte Tuya configuré dans le .env (docs/TUYA.md), et les détecteurs appairés dans l'application Smart Life.",
  "floors": [
    { "id": "rdc", "name": "Rez-de-chaussée", "plan": "plans/rdc.svg" },
    { "id": "etage", "name": "Étage", "plan": "plans/etage.svg" }
  ],
  "zones": [
    { "name": "Portail", "floor": "rdc" },
    { "name": "Jardin", "floor": "rdc" },
    { "name": "Séjour", "floor": "rdc" },
    { "name": "Local technique", "floor": "rdc" },
    { "name": "Étage - Couloir", "floor": "etage" }
  ],
  "devices": [
    {
      "id": "CAM-PORTAIL", "kind": "camera", "name": "Caméra portail", "zone": "Portail", "x": 50, "y": 8,
      "model": "dahua-hac-hfw1500th-i8", "qualification": "to_qualify",
      "source": {
        "type": "rtsp", "host": { "$ask": "Adresse IP de l'enregistreur" }, "port": 554, "path": "/cam/realmonitor?channel=1&subtype=1",
        "credentials": { "username": { "$ask": "Identifiant de l'enregistreur (compte en lecture seule)" }, "password": { "$ask": "Mot de passe de l'enregistreur" } }
      }
    },
    {
      "id": "CAM-JARDIN", "kind": "camera", "name": "Caméra jardin", "zone": "Jardin", "x": 10, "y": 88,
      "model": "dahua-hac-hfw1500th-i8", "qualification": "to_qualify",
      "source": {
        "type": "rtsp", "host": { "$ask": "Adresse IP de l'enregistreur" }, "port": 554, "path": "/cam/realmonitor?channel=2&subtype=1",
        "credentials": { "username": { "$ask": "Identifiant de l'enregistreur (compte en lecture seule)" }, "password": { "$ask": "Mot de passe de l'enregistreur" } }
      }
    },
    {
      "id": "NVR-01", "kind": "detector", "name": "Enregistreur vidéo", "zone": "Local technique", "x": 30, "y": 70,
