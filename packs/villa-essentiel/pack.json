      "category": "environment",
      "source": { "type": "network", "host": { "$ask": "Adresse IP de l'enregistreur" }, "port": 80 }
    },
    {
      "id": "I-PORTAIL", "kind": "detector", "name": "Personne détectée au portail", "zone": "Portail", "x": 54, "y": 8,
      "model": "dahua-xvr5104hs-i3", "qualification": "to_qualify",
